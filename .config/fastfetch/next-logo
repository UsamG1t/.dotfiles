#!/usr/bin/env python3
"""Print the next PNG path; share a session-local counter between terminals."""

import fcntl
import os
from pathlib import Path
import stat
import sys


def main():
    directory = Path(__file__).resolve().parent
    images = sorted(
        path for path in directory.iterdir()
        if path.suffix.lower() == ".png" and path.is_file()
    )
    if not images:
        raise ValueError(f"В {directory} нет PNG-изображений")

    # Both locations are volatile on Manjaro; the fallback also works from a TTY.
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or "/dev/shm")
    state_dir = runtime / f"fastfetch-{os.getuid()}"
    state_dir.mkdir(mode=0o700, exist_ok=True)
    info = state_dir.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError(f"Небезопасные права каталога счётчика: {state_dir}")

    descriptor = os.open(state_dir / "next-index", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "r+", encoding="ascii", errors="replace") as state:
        fcntl.flock(state, fcntl.LOCK_EX)
        value = state.read(64).strip()
        index = int(value) % len(images) if value.isascii() and value.isdecimal() else 0
        state.seek(0)
        state.write(str((index + 1) % len(images)))
        state.truncate()
        state.flush()

    print(images[index])


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        print(f"fastfetch next-logo: {error}", file=sys.stderr)
        sys.exit(1)
