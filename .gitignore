# Сгенерированный файл — пересобирается автоматически
.config/hypr/modules/keyhints.txt

# Большие бинарники — устанавливаются вручную
.local/bin/*.AppImage

# Локальные настройки оболочки не сохраняются в репозитории
/.zshrc.local

# Виртуальное окружение создаётся отдельно на каждой машине
/.usamg1t/
__pycache__/
*.py[cod]

# Локальные тесты систем не хранятся в репозитории
setup/