#!/usr/bin/env bash
# firefox-here — Super+Ctrl+F
# Переносит существующее окно Firefox на текущий воркспейс.
# Если Firefox не запущен — открывает его (окно уйдёт на ws2 через правило).
#
# Install: cp firefox-here ~/.local/bin/ && chmod +x ~/.local/bin/firefox-here

TARGET_WS=$(hyprctl activeworkspace -j | python3 -c "import sys,json; print(json.load(sys.stdin)['id'])")

if hyprctl clients -j 2>/dev/null | python3 -c "
import sys, json
clients = json.load(sys.stdin)
exit(0 if any(c.get('class','').lower() == 'firefox' for c in clients) else 1)
"; then
    hyprctl dispatch movetoworkspace "$TARGET_WS,class:firefox"
else
    firefox &
fi
