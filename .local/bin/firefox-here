#!/usr/bin/env bash
# firefox-here — Super+Ctrl+F
# Переносит существующее окно Firefox на текущий воркспейс.
# Если Firefox не запущен — открывает его (окно уйдёт на ws2 через правило).
#
# Install: cp firefox-here ~/.local/bin/ && chmod +x ~/.local/bin/firefox-here

exec hyprctl eval '
local workspace = hl.get_active_workspace()
if not workspace then return end
for _, window in ipairs(hl.get_windows()) do
    if window.class:lower() == "firefox" then
        hl.dispatch(hl.dsp.window.move({ window = window, workspace = workspace, follow = true }))
        hl.dispatch(hl.dsp.focus({ window = window }))
        return
    end
end
hl.exec_cmd("firefox")
'
