#!/usr/bin/env bash
# send-home-or-other — ручной запуск (биндинг Super+Shift+O удалён)
# Если активное окно на Other (7) → отправить на его домашний воркспейс по классу
# Если не на Other → отправить на Other
#
# Install: cp send-home-or-other ~/.local/bin/ && chmod +x ~/.local/bin/send-home-or-other

exec hyprctl eval '
local window = hl.get_active_window()
if not window or not window.workspace then return end
local homes = {
    firefox = 2, ["org.telegram.desktop"] = 2, thunderbird = 2,
    ["code-oss"] = 3, sublime_text = 3, ["org.kde.kate"] = 3,
    ["virtualbox manager"] = 4, ["virt-manager"] = 4,
    ["kitty-yazi"] = 5, ["kitty-terminal"] = 5,
}
local target = 7
if window.workspace.id == 7 then
    target = homes[window.class:lower()]
    if not target then return end
end
hl.dispatch(hl.dsp.window.move({ window = window, workspace = target, follow = true }))
'
