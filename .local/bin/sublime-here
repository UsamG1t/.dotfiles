#!/usr/bin/env bash
# sublime-here — Super+Ctrl+[
# Переносит существующее окно Sublime Text на текущий воркспейс.
# Если Sublime не запущен — открывает его (окно уйдёт на ws3 через правило).
#
# Install: cp sublime-here ~/.local/bin/ && chmod +x ~/.local/bin/sublime-here

exec hyprctl eval '
local workspace = hl.get_active_workspace()
if not workspace then return end
for _, window in ipairs(hl.get_windows()) do
    if window.class:lower() == "sublime_text" then
        hl.dispatch(hl.dsp.window.move({ window = window, workspace = workspace, follow = true }))
        hl.dispatch(hl.dsp.focus({ window = window }))
        return
    end
end
hl.exec_cmd("subl")
'
