#!/usr/bin/env bash
# thunderbird-here — Super+Ctrl+T
# Переносит существующее окно Thunderbird на текущий воркспейс.
# Если Thunderbird не запущен — открывает его (окно уйдёт на ws2 через правило).
#
# Install: cp thunderbird-here ~/.local/bin/ && chmod +x ~/.local/bin/thunderbird-here

exec hyprctl eval '
local workspace = hl.get_active_workspace()
if not workspace then return end
for _, window in ipairs(hl.get_windows()) do
    if window.class:lower() == "thunderbird" then
        hl.dispatch(hl.dsp.window.move({ window = window, workspace = workspace, follow = true }))
        hl.dispatch(hl.dsp.focus({ window = window }))
        return
    end
end
hl.exec_cmd("thunderbird")
'
