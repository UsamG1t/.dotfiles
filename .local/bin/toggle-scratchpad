#!/usr/bin/env bash
# toggle-scratchpad — Super+Shift+S
# Если окно в скрэтчпаде → вернуть на текущий воркспейс
# Если нет → отправить в скрэтчпад

exec hyprctl eval '
local window = hl.get_active_window()
local workspace = hl.get_active_workspace()
if not window or not workspace then return end

if window.workspace and window.workspace.config_name == "special:magic" then
    hl.dispatch(hl.dsp.window.move({ window = window, workspace = workspace, follow = true }))
else
    hl.dispatch(hl.dsp.window.move({ window = window, workspace = "special:magic", follow = false }))
end
'
