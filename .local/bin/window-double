#!/usr/bin/env bash
# window-double — удваивает размер активного плавающего окна
# Install: cp window-double ~/.local/bin/ && chmod +x ~/.local/bin/window-double

exec hyprctl eval '
local window = hl.get_active_window()
if not window or not window.floating then return end
hl.dispatch(hl.dsp.window.resize({
    window = window,
    x = window.size.x * 2,
    y = window.size.y * 2,
    relative = false,
}))
'
