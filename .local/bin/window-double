#!/usr/bin/env bash
# window-double — удваивает размер активного плавающего окна
# Install: cp window-double ~/.local/bin/ && chmod +x ~/.local/bin/window-double

read -r W H < <(
    hyprctl activewindow -j | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(d['size'][0], d['size'][1])
"
)

# resizeactive работает через дельту: чтобы удвоить, добавляем текущий размер
hyprctl dispatch resizeactive "$W $H"
