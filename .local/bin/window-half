#!/usr/bin/env bash
# window-half — уменьшает размер активного плавающего окна вдвое
# Install: cp window-half ~/.local/bin/ && chmod +x ~/.local/bin/window-half

read -r W H < <(
    hyprctl activewindow -j | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(d['size'][0], d['size'][1])
"
)

# Отрицательная дельта = убрать половину каждого измерения
hyprctl dispatch resizeactive "$(( -(W / 2) )) $(( -(H / 2) ))"
