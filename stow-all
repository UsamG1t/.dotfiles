#!/usr/bin/env python3

import argparse
import configparser
import os
from pathlib import Path
import shutil
import subprocess
import sys


REPO_DIR = Path(__file__).resolve().parent
HOME_DIR = Path.home().resolve()
SDDM_CONFIG_DIR = Path("/etc/sddm.conf.d")
SDDM_THEME_DIR = Path("/usr/share/sddm/themes/sddm-astronaut-theme")
PYTHON_SETUP = REPO_DIR / "setup/python-env.py"

HYPRLAND_SCRIPTS = (
    "calendar-popup", "firefox-here", "lock-screen", "notifications-status",
    "screenshot", "send-home-or-other", "show-hints", "sublime-here",
    "thunderbird-here", "toggle-bluetooth", "toggle-btop", "toggle-scratchpad", "tailscale-panel",
    "wallpaper-daemon", "window-double", "window-half",
)
HYPRLAND_IGNORES = (
    r"(^|/)\.config/(hypr|hyprland|waybar)$",
    r"(^|/)\.local/bin/(" + "|".join(HYPRLAND_SCRIPTS) + r")$",
)


def stow_dir(source, target, package=".", *, dry_run=False, use_sudo=False, ignore=()):
    """Развернуть один пакет; при пробном запуске не менять файлы и не вызывать sudo."""
    command = [
        "stow", "--restow", "--no-folding", "--verbose=1",
        f"--dir={source}", f"--target={target}",
    ]
    command.extend(f"--ignore={pattern}" for pattern in ignore)
    if dry_run:
        command.append("--simulate")
    elif use_sudo:
        command = ["sudo", "--", *command]
    command.append(package)
    return subprocess.run(command, check=not dry_run).returncode == 0


def main():
    parser = argparse.ArgumentParser(
        description="Развернуть настройки через Stow и подготовить Python-окружение ~/.usamg1t.",
        epilog="Запускайте без sudo. Конфликтующие файлы нужно заранее сохранить и убрать с целевых путей.",
    )
    parser.add_argument("-n", "--dry-run", action="store_true", help="Проверить без изменений, установки пакетов и sudo")
    parser.add_argument("--no-hyprland", action="store_true", help="Пропустить Hyprland, Waybar, SDDM и связанные скрипты")
    args = parser.parse_args()

    if os.geteuid() == 0:
        raise ValueError("Запустите скрипт без sudo, от владельца домашних настроек.")
    if not shutil.which("stow"):
        raise ValueError("Не установлен пакет stow.")
    if REPO_DIR == HOME_DIR:
        raise ValueError("Репозиторий должен находиться в отдельном каталоге.")
    subprocess.run([sys.executable, str(PYTHON_SETUP), "--dry-run"], check=True)

    ignore = HYPRLAND_IGNORES if args.no_hyprland else ()
    targets = [(REPO_DIR, HOME_DIR, ".", False)]
    if not args.no_hyprland:
        for directory in (SDDM_CONFIG_DIR, SDDM_THEME_DIR / "Themes"):
            if not directory.is_dir():
                raise ValueError(f"Не найден {directory}. Установите SDDM и sddm-astronaut-theme.")
        background = SDDM_THEME_DIR / "Backgrounds/Fantasy-Medieval_Travern.png"
        if not background.is_file():
            raise ValueError(f"Не найден фон {background}.")
        metadata = configparser.ConfigParser(interpolation=None)
        metadata.read(SDDM_THEME_DIR / "metadata.desktop")
        if metadata.get("SddmGreeterTheme", "ConfigFile", fallback="") != "Themes/hyprland_custom.conf":
            raise ValueError(f"Укажите ConfigFile=Themes/hyprland_custom.conf в {SDDM_THEME_DIR / 'metadata.desktop'}.")
        targets.extend([
            (REPO_DIR / "sddm", SDDM_CONFIG_DIR, "config", True),
            (REPO_DIR / "sddm", SDDM_THEME_DIR / "Themes", "theme", True),
        ])

    # Проверяем все направления до установки пакетов и создания ссылок.
    checks = [
        stow_dir(source, target, package, dry_run=True, ignore=ignore)
        for source, target, package, _ in targets
    ]
    if not all(checks):
        raise ValueError("Предварительная проверка Stow не прошла; изменения не применены.")
    if args.dry_run:
        print("Проверка завершена; файлы, пакеты и права доступа не изменены.")
        return

    if not args.no_hyprland:
        if not shutil.which("sudo"):
            raise ValueError("Не установлен пакет sudo.")
        subprocess.run(["sudo", "-v"], check=True)
        for source in (REPO_DIR / "sddm/config/theme.conf", REPO_DIR / "sddm/theme/hyprland_custom.conf"):
            if subprocess.run(["sudo", "-u", "sddm", "--", "test", "-r", str(source)]).returncode:
                raise ValueError(f"Пользователь sddm не может прочитать {source}. Настройте доступ к репозиторию (например, ACL).")

    subprocess.run([sys.executable, str(PYTHON_SETUP)], check=True)
    for source, target, package, use_sudo in targets:
        stow_dir(source, target, package, use_sudo=use_sudo, ignore=ignore)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, configparser.Error, subprocess.CalledProcessError) as error:
        print(f"stow-all: {error}", file=sys.stderr)
        sys.exit(1)
